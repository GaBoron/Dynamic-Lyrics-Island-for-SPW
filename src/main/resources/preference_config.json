{
  "configs": [
    {
      "title": "灵动词岛",
      "config": "island.json",
      "preferences": [
        {
          "type": "switch",
          "key": "enabled",
          "title": "显示词岛",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "translation",
          "title": "显示翻译",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "karaoke",
          "title": "逐字高亮与长音强调",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "click_through",
          "title": "鼠标穿透",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "auto_hide_on_hover",
          "title": "鼠标经过时自动隐藏",
          "default_value": false,
          "summary": "仅在鼠标穿透开启时生效：鼠标进入词岛区域后缩小消失，移开后展开恢复。"
        },
        {
          "type": "switch",
          "key": "hide_fullscreen",
          "title": "全屏时隐藏",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "hide_paused",
          "title": "暂停时隐藏",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "reduced_motion",
          "title": "减少动画",
          "default_value": false
        },
        {
          "type": "list",
          "key": "shape",
          "title": "外观",
          "entries": [
            "胶囊",
            "顶部刘海"
          ],
          "entry_values": [
            "pill",
            "notch"
          ],
          "default_value": "pill"
        },
        {
          "type": "seekbar",
          "key": "corner_roundness",
          "title": "圆角大小 %",
          "default_value": 60,
          "min": 0,
          "max": 100,
          "summary": "0 为直角，100 为最大圆角；圆角会随词岛高度自动缩放。"
        },
        {
          "type": "edittext",
          "key": "font_family",
          "title": "字体",
          "default_value": "Microsoft YaHei UI",
          "summary": "输入已安装的字体名称。"
        },
        {
          "type": "seekbar",
          "key": "font_size",
          "title": "字号",
          "default_value": 22,
          "min": 14,
          "max": 42
        },
        {
          "type": "seekbar",
          "key": "max_width",
          "title": "最大宽度",
          "default_value": 640,
          "min": 280,
          "max": 1200
        },
        {
          "type": "switch",
          "key": "fixed_width",
          "title": "固定词岛宽度",
          "default_value": false,
          "summary": "开启后始终使用“最大宽度”的值，不再随歌词长度收缩。"
        },
        {
          "type": "list",
          "key": "leading_content",
          "title": "左侧信息",
          "entries": [
            "实时频谱",
            "专辑封面"
          ],
          "entry_values": [
            "spectrum",
            "cover"
          ],
          "default_value": "spectrum",
          "summary": "封面来自本地音频内嵌图片或同目录 cover/folder 图片。"
        },
        {
          "type": "seekbar",
          "key": "opacity",
          "title": "背景不透明度 %",
          "default_value": 96,
          "min": 35,
          "max": 100
        },
        {
          "type": "seekbar",
          "key": "offset_ms",
          "title": "逐字高亮偏移 ms",
          "default_value": 0,
          "min": -2000,
          "max": 2000
        },
        {
          "type": "switch",
          "key": "lyric_cover_color",
          "title": "歌词高亮与辉光使用封面颜色",
          "default_value": false,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        },
        {
          "type": "switch",
          "key": "background_cover_color",
          "title": "背景使用封面颜色",
          "default_value": false,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        },
        {
          "type": "switch",
          "key": "spectrum_cover_color",
          "title": "频谱使用封面颜色",
          "default_value": false,
          "summary": "从本地音频内嵌封面或同目录 cover/folder 图片取色，无封面时使用默认颜色。"
        },
        {
          "type": "button",
          "title": "找回词岛",
          "summary": "显示词岛、解除鼠标穿透并回到主屏幕顶部。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.recover"
        },
        {
          "type": "button",
          "title": "原创署名与许可证（Lyricify / AMLL）",
          "summary": "Lyricify：CC BY-SA 4.0；AMLL 动画模块：AGPL-3.0；其他程序：GPL-3.0。",
          "arrow_type": "none",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.about"
        },
        {
          "type": "button",
          "title": "项目源代码（GitHub）",
          "summary": "查看源代码、反馈问题与参与贡献。",
          "arrow_type": "link",
          "on_click": "io.github.gaboron.spwisland.host.IslandPlugin.openSource"
        }
      ]
    }
  ]
}
