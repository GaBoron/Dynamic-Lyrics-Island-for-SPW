<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IslandFontPicker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IslandFontPicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock CharacterSpacing="120"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       Text="LYRICS APPEARANCE" />
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="歌词字体与排版" />
            <TextBlock HorizontalAlignment="Left"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="选择字体与可用字型，细调字重和字号，实时预览词岛效果。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="ContentLayout" Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FontListColumn" Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FontListCard" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox x:Name="FontSearchBox"
                                    AutomationProperties.AutomationId="FontSearchBox"
                                    AutomationProperties.Name="搜索字体"
                                    PlaceholderText="搜索字体"
                                    QueryIcon="Find"
                                    TextChanged="FontSearchBox_TextChanged" />

                    <Grid Grid.Row="1">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="可用字体" />
                        <TextBlock x:Name="FontCountText"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>

                    <ListView x:Name="FontList"
                              Grid.Row="2"
                              AutomationProperties.AutomationId="FontList"
                              AutomationProperties.Name="可用字体列表"
                              ItemsSource="{x:Bind FilteredFonts}"
                              SelectionChanged="FontList_SelectionChanged"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="64" />
                                <Setter Property="Padding" Value="12,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FontOption">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{x:Bind Family}"
                                                   FontSize="17"
                                                   Text="Aa" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontFamily="{x:Bind Family}"
                                                   FontSize="15"
                                                   Text="{x:Bind DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                                   Text="{x:Bind Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PreviewScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="歌词预览" />
                            <TextBlock x:Name="SelectedFontText" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                Padding="10,5"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="仅影响歌词" />
                        </Border>
                    </Grid>

                    <Border MinHeight="180"
                            Padding="24"
                            Background="#F20E1118"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Grid>
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="650"
                                    Padding="26,16"
                                    Background="#F51B202B"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="32">
                                <StackPanel Spacing="9">
                                    <TextBlock x:Name="PrimaryPreviewText"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Normal"
                                               Text="若深夜的风掠过海面"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SecondaryPreviewText"
                                               Foreground="#A9C0C7D2"
                                               FontSize="14"
                                               Text="Let every word arrive in its own rhythm."
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel Spacing="11">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="排版设置" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="字形样式" />
                                    <ComboBox x:Name="FaceSelector" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="字形样式"
                                              DisplayMemberPath="DisplayName"
                                              ItemsSource="{x:Bind SelectedShapes}"
                                              SelectionChanged="FaceSelector_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="预览文本" />
                                    <TextBox x:Name="PreviewInput" PlaceholderText="输入预览文本"
                                             AutomationProperties.Name="预览文本"
                                             Text="若深夜的风掠过海面"
                                             TextChanged="PreviewInput_TextChanged" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="字重" />
                                        <TextBlock x:Name="WeightValueText" HorizontalAlignment="Right"
                                                   Style="{StaticResource MutedTextStyle}" />
                                    </Grid>
                                    <Slider x:Name="WeightSlider" Minimum="100" Maximum="900" StepFrequency="1"
                                            AutomationProperties.Name="歌词字重"
                                            ValueChanged="WeightSlider_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <Grid>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="字号" />
                                        <TextBlock x:Name="SizeValueText" HorizontalAlignment="Right"
                                                   Style="{StaticResource MutedTextStyle}" />
                                    </Grid>
                                    <Slider x:Name="SizeSlider" Minimum="14" Maximum="42" StepFrequency="1"
                                            AutomationProperties.Name="歌词字号"
                                            ValueChanged="SizeSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Button AutomationProperties.AutomationId="RestoreDefaultButton"
                    AutomationProperties.Name="恢复插件内置字体"
                    Click="RestoreDefault_Click"
                    Content="恢复默认" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                <Button AutomationProperties.AutomationId="CancelButton"
                        AutomationProperties.Name="取消"
                        Click="Cancel_Click"
                        Content="取消" />
                <Button AutomationProperties.AutomationId="ApplyButton"
                        AutomationProperties.Name="使用所选字体"
                        Click="Apply_Click"
                        Content="应用设置"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FontListColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FontListColumn.Width" Value="360" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
