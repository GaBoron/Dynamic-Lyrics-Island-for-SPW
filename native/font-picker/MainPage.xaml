<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IslandFontPicker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IslandFontPicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock CharacterSpacing="120"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       Text="LYRICS APPEARANCE" />
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="选择歌词字体" />
            <TextBlock HorizontalAlignment="Left"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="从已安装字体中选择歌词字体和字重，确认后立即应用到词岛。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="ContentLayout" Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FontListColumn" Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FontListCard" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox x:Name="FontSearchBox"
                                    AutomationProperties.AutomationId="FontSearchBox"
                                    AutomationProperties.Name="搜索字体"
                                    PlaceholderText="搜索字体"
                                    QueryIcon="Find"
                                    TextChanged="FontSearchBox_TextChanged" />

                    <Grid Grid.Row="1">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="可用字体" />
                        <TextBlock x:Name="FontCountText"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>

                    <ListView x:Name="FontList"
                              Grid.Row="2"
                              AutomationProperties.AutomationId="FontList"
                              AutomationProperties.Name="可用字体列表"
                              ItemsSource="{x:Bind FilteredFonts}"
                              SelectionChanged="FontList_SelectionChanged"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="64" />
                                <Setter Property="Padding" Value="12,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FontOption">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{x:Bind Family}"
                                                   FontSize="17"
                                                   Text="Aa" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontFamily="{x:Bind Family}"
                                                   FontSize="15"
                                                   Text="{x:Bind DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                                   Text="{x:Bind Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PreviewScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="歌词预览" />
                            <TextBlock x:Name="SelectedFontText" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                Padding="10,5"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="仅影响歌词" />
                        </Border>
                    </Grid>

                    <Border MinHeight="250"
                            Padding="34"
                            Background="#F20E1118"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Grid>
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="650"
                                    Padding="30,22"
                                    Background="#F51B202B"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="32">
                                <StackPanel Spacing="9">
                                    <TextBlock x:Name="PrimaryPreviewText"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Normal"
                                               Text="若深夜的风掠过海面"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SecondaryPreviewText"
                                               Foreground="#A9C0C7D2"
                                               FontSize="14"
                                               Text="Let every word arrive in its own rhythm."
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Foreground="#8796A0AF"
                                       FontSize="11"
                                       Text="词岛效果示意 · 主歌词 24 px · 翻译 14 px" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="预览文本" />
                            <TextBox x:Name="PreviewInput"
                                     AutomationProperties.Name="预览文本"
                                     Text="若深夜的风掠过海面"
                                     TextChanged="PreviewInput_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="字体字型" />
                            <ComboBox x:Name="WeightSelector"
                                      AutomationProperties.AutomationId="WeightSelector"
                                      AutomationProperties.Name="字体字型"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind SelectedFaces}"
                                      SelectionChanged="WeightSelector_SelectionChanged" />
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="StatusInfoBar"
                             IsClosable="False"
                             IsOpen="True"
                             Message="只列出当前字体实际包含的字型；确认后词岛会直接使用所选的真实字面。"
                             Severity="Informational"
                             Title="字型说明" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Button AutomationProperties.AutomationId="RestoreDefaultButton"
                    AutomationProperties.Name="恢复插件内置字体"
                    Click="RestoreDefault_Click"
                    Content="恢复内置字体" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                <Button AutomationProperties.AutomationId="CancelButton"
                        AutomationProperties.Name="取消"
                        Click="Cancel_Click"
                        Content="取消" />
                <Button AutomationProperties.AutomationId="ApplyButton"
                        AutomationProperties.Name="使用所选字体"
                        Click="Apply_Click"
                        Content="使用此字体"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FontListColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FontListColumn.Width" Value="360" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
